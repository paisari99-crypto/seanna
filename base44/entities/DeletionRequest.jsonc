{
  "name": "DeletionRequest",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string",
      "relation": {
        "entity": "UserProfile",
        "type": "many-to-one"
      },
      "description": "Reference to UserProfile"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "processing",
        "completed",
        "failed"
      ],
      "default": "requested",
      "description": "Deletion request status"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "data.userId": "{{user.id}}"
    },
    "read": {
      "data.userId": "{{user.id}}"
    },
    "update": {
      "data.userId": "{{user.id}}"
    },
    "delete": {
      "data.userId": "{{user.id}}"
    }
  }
}